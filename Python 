from dataclasses import dataclass
from datetime import datetime, timezone
import hashlib
import json
from typing import List

# Import cryptographic primitives
from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives.asymmetric import ed25519

@dataclass(frozen=True)
class TransactionToken:
    """
    Strongly-typed, cryptographically signed token representing an atomic state action.
    """
    event_id: str
    payload_hash: str
    timestamp: str
    public_key_bytes: bytes  # Identity of the entity executing the transition
    signature: bytes         # Ed25519 signature proving identity signed the transition parameters

class CryptographicHistoryEngine:
    def __init__(self, genesis_message: str = "GENESIS_BLOCK_MAXIMUS_INTEGRITY"):
        # Establish the initial immutable root anchor (H_0)
        self.genesis_hash = hashlib.sha256(genesis_message.encode('utf-8')).hexdigest()
        self.chain: List[str] = [self.genesis_hash]
        self.token_ledger: List[TransactionToken] = []

    def tokenize_and_append(self, event_id: str, raw_payload: dict, private_key: ed25519.Ed25519PrivateKey) -> str:
        """
        Tokenizes payload, extracts the public identity, signs the context,
        and binds it tightly to the previous state history hash.
        """
        # 1. Normalize and hash raw input payload to enforce immutability
        serialized_payload = json.dumps(raw_payload, sort_keys=True).encode('utf-8')
        payload_hash = hashlib.sha256(serialized_payload).hexdigest()
        
        # 2. Capture an immutable timestamp anchor
        timestamp = datetime.now(timezone.utc).isoformat()
        
        # 3. Extract the clean Public Key bytes to embed as the identity vector
        public_key = private_key.public_key()
        public_key_bytes = public_key.public_bytes_raw()
        
        # 4. Construct the precise bytes string that needs to be legally signed
        # This message binds the event type, data payload, time, and prior chain state together
        previous_hash = self.chain[-1]
        signing_payload = f"{event_id}{payload_hash}{timestamp}{previous_hash}".encode('utf-8')
        
        # 5. Generate the raw Ed25519 signature
        signature = private_key.sign(signing_payload)
        
        # 6. Mint the immutable structured token
        token = TransactionToken(
            event_id=event_id,
            payload_hash=payload_hash,
            timestamp=timestamp,
            public_key_bytes=public_key_bytes,
            signature=signature
        )
        
        # 7. Generate the new top-level State History Hash (H_n) from the full token context
        token_bytes = f"{token.event_id}{token.payload_hash}{token.timestamp}".encode('utf-8')
        hash_input = previous_hash.encode('utf-8') + token_bytes + token.public_key_bytes + token.signature
        new_state_hash = hashlib.sha256(hash_input).hexdigest()
        
        # 8. Commit permanently to the internal memory matrix
        self.chain.append(new_state_hash)
        self.token_ledger.append(token)
        
        return new_state_hash

    def verify_ledger_integrity(self) -> bool:
        """
        Audits the entire execution history from the Genesis block forward.
        Verifies both linear chain continuity and individual cryptographic signatures.
        """
        current_hash = self.genesis_hash
        
        for i, token in enumerate(self.token_ledger):
            # A. Reconstruct the message that was supposed to be signed
            signing_payload = f"{token.event_id}{token.payload_hash}{token.timestamp}{current_hash}".encode('utf-8')
            
            # B. Reconstruct the Public Key object from the token's embedded identity
            try:
                public_key = ed25519.Ed25519PublicKey.from_public_bytes_raw(token.public_key_bytes)
                # C. Cryptographically verify the Ed25519 signature
                public_key.verify(token.signature, signing_payload)
            except InvalidSignature:
                print(f"CRITICAL ACCOUNTABILITY ALERT: Cryptographic forgery detected at block index {i}!")
                return False
            except Exception as e:
                print(f"Systemic validation exception at block {i}: {str(e)}")
                return False
            
            # D. Re-compute the expected state history hash (H_n)
            token_bytes = f"{token.event_id}{token.payload_hash}{token.timestamp}".encode('utf-8')
            hash_input = current_hash.encode('utf-8') + token_bytes + token.public_key_bytes + token.signature
            recalculated_hash = hashlib.sha256(hash_input).hexdigest()
            
            # E. Confirm match against the recorded state track
            if recalculated_hash != self.chain[i + 1]:
                print(f"CRITICAL ACCOUNTABILITY ALERT: Hash chain continuity broken at block index {i}!")
                return False
                
            current_hash = recalculated_hash
            
        return True

